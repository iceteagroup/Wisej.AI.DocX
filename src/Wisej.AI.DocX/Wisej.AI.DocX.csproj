<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(NetStandardVersion);$(NetCoreVersion)</TargetFrameworks>
		<RootNamespace>Wisej.AI.DocX</RootNamespace>
		<AssemblyName>Wisej.AI.DocX</AssemblyName>
		<SignAssembly>True</SignAssembly>
		<AssemblyOriginatorKeyFile>extension.snk</AssemblyOriginatorKeyFile>

		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- Every public member must be documented: missing XML comments fail the build. -->
		<WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1573;CS1572;CS1574</WarningsAsErrors>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<!-- The assembly attributes are declared in Properties\AssemblyInfo.cs. -->
	<PropertyGroup>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
		<GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
		<GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
		<GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
		<GenerateAssemblyNeutralLanguageAttribute>false</GenerateAssemblyNeutralLanguageAttribute>
		<GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
	</PropertyGroup>

	<ItemGroup>
		<!-- Same version referenced by Wisej.AI, so both libraries share one copy. -->
		<PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
	</ItemGroup>

	<!-- Friend assemblies are signed with the same key (see Directory.Build.props). -->
	<PropertyGroup>
		<FriendPublicKey></FriendPublicKey>
	</PropertyGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Wisej.AI.DocX.Tests" Key="$(FriendPublicKey)" />
	</ItemGroup>

</Project>
